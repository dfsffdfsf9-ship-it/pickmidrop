
{
  "name": "pickmidrop-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PickmiDrop desktop school demo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:desktop": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "school.pickmidrop.demo",
    "productName": "PickmiDrop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "portable"
    }
  }
}
